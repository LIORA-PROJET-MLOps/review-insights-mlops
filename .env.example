APP_ENV=local
APP_NAME=Review Insights+
APP_VERSION=0.2.0
API_HOST=0.0.0.0
API_PORT=8000
THEME_THRESHOLD=0.34
MODELS_DIR=models
MODEL_SOURCE=local
HF_MODEL_REPO_ID=
HF_MODEL_REVISION=1d6a5bd3e653ba75b6c8fed614e156d1a3c73779
HF_TOKEN=
HF_CACHE_DIR=.cache/huggingface
HF_ARTIFACTS_DIR=.cache/review_insights/models
MAX_REVIEW_CHARS=5000
REQUIRE_API_KEY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MLFLOW_TRACKING_ENABLED=false
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=review-insights-default
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me-mlflow-db
MLFLOW_DB_NAME=mlflow
MINIO_ROOT_USER=review-insights
MINIO_ROOT_PASSWORD=change-me-minio-secret
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
DVC_DATA_BUCKET=review-insights-data
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true
MLFLOW_PRINT_MODEL_URLS_ON_CREATION=false
ALLOWED_ORIGINS=*
TRUSTED_HOSTS=*
ENABLE_DOCS=true
SERVICE_TIMEOUT_SECONDS=15

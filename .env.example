APP_ENV=local
APP_NAME=Review Insights+
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
THEME_THRESHOLD=0.34
MODELS_DIR=models
MODEL_SOURCE=local
HF_MODEL_REPO_ID=
HF_MODEL_REVISION=1d6a5bd3e653ba75b6c8fed614e156d1a3c73779
HF_TOKEN=
HF_CACHE_DIR=.cache/huggingface
HF_ARTIFACTS_DIR=.cache/review_insights/models
SENTIMENT_BACKEND=project
HF_SENTIMENT_MODEL_ID=SebasLopez-ai/distilbert-amazon-reviews-sentiment
HF_SENTIMENT_REVISION=881c6455b01b7ef50026f33902f6433651a1b1f0
HF_SENTIMENT_ARTIFACTS_DIR=.cache/review_insights/sentiment
HF_SENTIMENT_MAX_LENGTH=256
SENTIMENT_REVIEW_THRESHOLD=0.45
MAX_REVIEW_CHARS=5000
REQUIRE_API_KEY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MLFLOW_TRACKING_ENABLED=false
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=review-insights-default
FEEDBACK_STORE_PATH=data/feedback/human_feedback.jsonl
PREDICTION_EVENT_STORE_PATH=
DRIFT_POLICY_PATH=config/drift_policy_v1.json
DRIFT_REPORT_PATH=reports/drift/latest_drift_report.json
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me-mlflow-db
MLFLOW_DB_NAME=mlflow
MINIO_ROOT_USER=review-insights
MINIO_ROOT_PASSWORD=change-me-minio-secret
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
DVC_DATA_BUCKET=review-insights-data
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true
MLFLOW_PRINT_MODEL_URLS_ON_CREATION=false
ALLOWED_ORIGINS=*
TRUSTED_HOSTS=*
ENABLE_DOCS=true
SERVICE_TIMEOUT_SECONDS=15
DAGSTER_DB_USER=dagster
DAGSTER_DB_PASSWORD=change-me-dagster-db
DAGSTER_DB_NAME=dagster
ORCHESTRATOR_DEFAULT_SOURCE_CSV=data/sample/reviews_poc_test.csv
ALERT_WEBHOOK_URL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
API_START_PERIOD=180s

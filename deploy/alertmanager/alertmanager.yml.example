global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'ton.adresse@gmail.com'
  smtp_auth_username: 'ton.adresse@gmail.com'
  smtp_auth_password: 'le-mot-de-passe-application-16-caracteres'
  smtp_require_tls: true

route:
  receiver: control-center
  group_by: [alertname, domain, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: control-center
    email_configs:
      - to: 'adresse.destinataire@exemple.com'
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [alertname, domain]
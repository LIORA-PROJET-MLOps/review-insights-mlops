{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Dagster", "type": "link", "url": "http://localhost:3001", "targetBlank": true},
    {"title": "MLflow", "type": "link", "url": "http://localhost:5000", "targetBlank": true}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "REJETÉ"}, "1": {"color": "green", "text": "READY"}}, "type": "value"}]}},
      "gridPos": {"h": 5, "w": 5, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none"},
      "targets": [{"expr": "review_insights_data_quality_ready", "instant": true, "refId": "A"}],
      "title": "Qualité dernier dataset",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 9, "x": 5, "y": 0},
      "id": 2,
      "options": {"displayMode": "gradient", "orientation": "horizontal"},
      "targets": [{"expr": "review_insights_data_rows", "instant": true, "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Volumes du dernier dataset",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "h"}},
      "gridPos": {"h": 5, "w": 5, "x": 0, "y": 5},
      "id": 3,
      "targets": [{"expr": "(time() - review_insights_data_last_ingestion_timestamp_seconds) / 3600", "instant": true, "refId": "A"}],
      "title": "Âge dernière ingestion",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 0},
      "id": 4,
      "options": {"displayMode": "gradient", "orientation": "horizontal"},
      "targets": [{"expr": "review_insights_model_metric", "instant": true, "legendFormat": "{{metric}}", "refId": "A"}],
      "title": "Métriques candidat",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "REJETÉ"}, "1": {"color": "green", "text": "APPROUVÉ"}}, "type": "value"}]}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 10},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none"},
      "targets": [{"expr": "review_insights_model_release_approved", "instant": true, "refId": "A"}],
      "title": "Quality gates modèle",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 10},
      "id": 6,
      "targets": [{"expr": "review_insights_model_training_rows", "instant": true, "refId": "A"}],
      "title": "Lignes d'entraînement",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "h"}},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 10},
      "id": 7,
      "targets": [{"expr": "(time() - review_insights_model_last_training_timestamp_seconds) / 3600", "instant": true, "refId": "A"}],
      "title": "Âge dernier entraînement",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 10},
      "id": 8,
      "targets": [{"expr": "count(review_insights_data_quality_check == 0) or vector(0)", "instant": true, "refId": "A"}],
      "title": "Checks data échoués",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "green", "text": "STABLE / COLLECTE"}, "1": {"color": "orange", "text": "RETRAINING CONSEILLÉ"}}, "type": "value"}]}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 16},
      "id": 10,
      "options": {"colorMode": "background", "graphMode": "none"},
      "targets": [{"expr": "review_insights_drift_retraining_recommended", "instant": true, "refId": "A"}],
      "title": "Décision drift",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}]}}},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 16},
      "id": 11,
      "options": {"displayMode": "gradient", "orientation": "horizontal"},
      "targets": [{"expr": "review_insights_drift_metric{metric=~\"sentiment_js_divergence|theme_js_divergence\"}", "instant": true, "legendFormat": "{{metric}}", "refId": "A"}],
      "title": "Divergences JS (seuil 0,10)",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.7}]}}},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 16},
      "id": 12,
      "options": {"colorMode": "value", "graphMode": "area"},
      "targets": [{"expr": "review_insights_drift_metric{metric=\"feedback_combined_accuracy\"}", "instant": true, "refId": "A"}],
      "title": "Précision feedback humain",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 16},
      "id": 13,
      "options": {"displayMode": "gradient", "orientation": "horizontal"},
      "targets": [
        {"expr": "review_insights_drift_prediction_events", "instant": true, "legendFormat": "prédictions", "refId": "A"},
        {"expr": "review_insights_drift_feedback_records", "instant": true, "legendFormat": "feedback joints", "refId": "B"}
      ],
      "title": "Fenêtre drift",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "h"}},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 22},
      "id": 14,
      "targets": [{"expr": "(time() - review_insights_drift_last_evaluation_timestamp_seconds) / 3600", "instant": true, "refId": "A"}],
      "title": "Âge dernière évaluation drift",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 27},
      "id": 9,
      "targets": [{"expr": "ALERTS{alertstate=\"firing\",domain=~\"data|model\"}", "format": "table", "instant": true, "refId": "A"}],
      "title": "Alertes données et modèles actives",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["review-insights", "data", "models", "mlflow", "dagster"],
  "templating": {"list": []},
  "time": {"from": "now-7d", "to": "now"},
  "timezone": "browser",
  "title": "Review Insights - Données & Modèles",
  "uid": "review-insights-data-models",
  "version": 1
}
